<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard">

    <!-- Dashboard Destination -->
    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.example.appointmentmanagement.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboard_to_bookAppointment"
            app:destination="@id/nav_book_appointment" />

        <action
            android:id="@+id/action_dashboard_to_myAppointments"
            app:destination="@id/nav_my_appointments" />
    </fragment>

    <!-- Book Appointment Destination -->
    <fragment
        android:id="@+id/nav_book_appointment"
        android:name="com.example.appointmentmanagement.ui.booking.BookAppointmentFragment"
        android:label="Book Appointment"
        tools:layout="@layout/fragment_book_appointment">

        <!-- Routes to appointment list, popping up to dashboard so back button doesn't loop back to booking form -->
        <action
            android:id="@+id/action_bookAppointment_to_myAppointments"
            app:destination="@id/nav_my_appointments"
            app:popUpTo="@id/nav_dashboard"
            app:popUpToInclusive="false" />
    </fragment>

    <!-- My Appointments Destination -->
    <fragment
        android:id="@+id/nav_my_appointments"
        android:name="com.example.appointmentmanagement.ui.appointments.MyAppointmentsFragment"
        android:label="My Appointments"
        tools:layout="@layout/fragment_my_appointments">

        <!-- Safe Args argument declaration -->
        <argument
            android:name="newAppointment"
            app:argType="com.example.appointmentmanagement.model.Appointment"
            app:nullable="true"
            android:defaultValue="@null" />

        <action
            android:id="@+id/action_myAppointments_to_bookAppointment"
            app:destination="@id/nav_book_appointment" />
    </fragment>

</navigation>